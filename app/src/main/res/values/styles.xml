<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.GhostGalleon" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">#FF000000</item>
        <item name="android:colorBackground">#FF000000</item>
        <item name="android:statusBarColor">#FF000000</item>
        <item name="android:navigationBarColor">#FF000000</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="colorPrimary">#FF1C1C22</item>
        <item name="colorPrimaryDark">#FF000000</item>
        <item name="colorAccent">#FF7986CB</item>
        <item name="colorControlNormal">#99FFFFFF</item>
        <item name="colorControlActivated">#FF7986CB</item>
        <item name="colorControlHighlight">#33FFFFFF</item>
        <item name="android:colorEdgeEffect">#FF7986CB</item>
        <item name="android:textColorHint">#66FFFFFF</item>
        <item name="android:textColorHighlight">#4D7986CB</item>
        <item name="alertDialogTheme">@style/Theme.GhostGalleon.Dialog</item>
        <item name="android:alertDialogTheme">@style/Theme.GhostGalleon.Dialog</item>
    </style>

    <style name="Theme.GhostGalleon.Dialog" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/bg_dialog_card</item>
        <item name="android:colorBackground">#FF1C1C22</item>
        <item name="colorAccent">#FF7986CB</item>
        <item name="colorControlNormal">#99FFFFFF</item>
        <item name="colorControlActivated">#FF7986CB</item>
        <item name="colorControlHighlight">#33FFFFFF</item>
        <item name="android:textColorPrimary">#FFFFFFFF</item>
        <item name="android:textColorSecondary">#CCFFFFFF</item>
        <item name="android:textColorHint">#66FFFFFF</item>
        <item name="android:textColorHighlight">#4D7986CB</item>
        <item name="android:textColorAlertDialogListItem">#FFFFFFFF</item>
        <item name="android:backgroundDimAmount">0.80</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.GhostGalleon.DialogButton.Positive</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.GhostGalleon.DialogButton</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.GhostGalleon.DialogButton</item>
    </style>

    <style name="Widget.GhostGalleon.DialogButton" parent="Widget.AppCompat.Button.ButtonBar.AlertDialog">
        <item name="android:background">@drawable/bg_dialog_button</item>
        <item name="android:textColor">#CCFFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
    </style>

    <style name="Widget.GhostGalleon.DialogButton.Positive" parent="Widget.GhostGalleon.DialogButton">
        <item name="android:textColor">#FF9FA8DA</item>
    </style>
</resources>
