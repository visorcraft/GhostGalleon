<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- View tag key holding the package name a pending custom-icon decode
         belongs to (CustomIcon stale-result guard). -->
    <item name="custom_icon_key" type="id" />
    <!-- GridView recycle: slot key last bound into this frame. -->
    <item name="grid_cell_key" type="id" />
    <!-- GameDeck carousel: entry key bound into a card holder. -->
    <item name="carousel_entry_key" type="id" />
    <!-- Companion hero: ArtCache write generation last bound for this ROM. -->
    <item name="hero_art_gen" type="id" />
    <!-- Companion hero: ROM id / package last bound (do not overwrite find-tags). -->
    <item name="hero_bound_id" type="id" />
    <!-- Companion media: URI last bound on screenshot / logo / video. -->
    <item name="media_bind_uri" type="id" />
    <!-- PlatformTile: last restyled platform id (keep default tag for find). -->
    <item name="platform_tile_id" type="id" />
    <!-- Winlator cockpit trackpad: last normalized 0..1 point (float[2]). -->
    <item name="cockpit_pad_point" type="id" />
    <!-- KEEP theater badge: ArtCache key last bound (keep find-tag). -->
    <item name="theater_badge_key" type="id" />
    <!-- Status pill: last applied battery chrome (percent/glyph/bars). -->
    <item name="status_chrome" type="id" />
</resources>
