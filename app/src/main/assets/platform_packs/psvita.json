{
  "schemaVersion": 1,
  "platforms": [
    {
      "id": "psvita",
      "displayName": "PlayStation Vita",
      "shortName": "Vita",
      "folderNames": ["psvita", "vita", "psv"],
      "extensions": ["vpk", "zip"],
      "players": [
        {
          "id": "vita3k",
          "displayName": "Vita3K",
          "component": "org.vita3k.emulator/.Emulator",
          "action": "android.intent.action.MAIN",
          "uriStyle": "URI",
          "extras": {
            "title_id": "{file.titleId}",
            "game_title": "{file.name}"
          },
          "grantRead": true
        },
        {
          "id": "vita3k-legacy",
          "displayName": "Vita3K (legacy)",
          "component": "org.vita3k.emulator/.EmulationActivity",
          "action": "android.intent.action.VIEW",
          "uriStyle": "URI",
          "extras": {
            "titleId": "{file.titleId}",
            "bootPath": "{file.pathOrUri}",
            "gamePath": "{file.pathOrUri}"
          },
          "grantRead": true
        },
        {
          "id": "vita3k-home",
          "displayName": "Vita3K (home)",
          "component": "org.vita3k.emulator/.MainActivity",
          "action": "android.intent.action.MAIN",
          "uriStyle": "URI",
          "extras": {},
          "grantRead": true
        }
      ]
    }
  ]
}
